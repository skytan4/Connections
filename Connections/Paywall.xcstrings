    "paywall.shareExperience.body": {
      "comment": "Body text on the Share Experiences feature paywall.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You tried a few selected prompts. Full Access unlocks the complete Share Experiences library, with more range, surprise, and depth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probaste algunos prompts seleccionados. Full Access desbloquea toda la biblioteca de Share Experiences, con más variedad, sorpresa y profundidad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbowano kilka wybranych promptów. Full Access odblokowuje całą bibliotekę Share Experiences, z większym zakresem, zaskoczeniem i głębią."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ein paar ausgewählte Impulse ausprobiert. Full Access schaltet die gesamte Share Experiences-Bibliothek frei, mit mehr Vielfalt, Überraschung und Tiefe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez essayé quelques questions sélectionnées. Full Access débloque toute la bibliothèque Share Experiences, avec plus de variété, de surprise et de profondeur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você experimentou alguns prompts selecionados. O Full Access desbloqueia a biblioteca completa do Share Experiences, com mais variedade, surpresa e profundidade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een paar geselecteerde prompts geprobeerd. Full Access ontgrendelt de volledige Share Experiences-bibliotheek, met meer variatie, verrassing en diepgang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつか選び抜かれたプロンプトを試しました。Full Accessでは、もっと幅広く、もっと意外で、もっと深いShare Experiencesのライブラリ全体が使えます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avete provato alcuni prompt selezionati. Full Access sblocca l’intera libreria Share Experiences, con più varietà, sorpresa e profondità."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har provat några utvalda promptar. Full Access låser upp hela Share Experiences-biblioteket, med mer bredd, överraskning och djup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har prøvet nogle udvalgte prompts. Full Access låser op for hele Share Experiences-biblioteket med mere variation, overraskelse og dybde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har prøvd noen utvalgte prompter. Full Access låser opp hele Share Experiences-biblioteket, med mer variasjon, overraskelse og dybde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilit muutamia valittuja kehotteita. Full Access avaa koko Share Experiences -kirjaston, jossa on enemmän vaihtelua, yllätyksiä ja syvyyttä."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你试用了几个精选提示。Full Access 可解锁完整的 Share Experiences 题库，带来更多范围、惊喜和深度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы попробовали несколько выбранных подсказок. Full Access открывает всю библиотеку Share Experiences — больше разнообразия, больше неожиданного, больше глубины."
          }
        }
      }
    },
