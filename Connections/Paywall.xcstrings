    "paywall.purchase.tagline": {
      "comment": "Fallback tagline shown below the primary purchase button if StoreKit price has not loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase. Lifetime access. No subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Acceso de por vida. Sin suscripción."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowy zakup. Dostęp dożywotni. Bez subskrypcji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Lebenslanger Zugriff. Kein Abo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Accès à vie. Sans abonnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Acesso vitalício. Sem assinatura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Levenslange toegang. Geen abonnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一回限りの購入。生涯アクセス。サブスクリプションではありません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto unico. Accesso a vita. Nessun abbonamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Engångsköp. Livstidsåtkomst. Ingen prenumeration."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskøb. Livstidsadgang. Intet abonnement."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskjøp. Livstidstilgang. Ingen abonnement."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertaostos. Elinikäinen käyttöoikeus. Ei tilausta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。终身访问。无需订阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Пожизненный доступ. Без подписки."
          }
        }
      }
    },
    "paywall.error.productUnavailable": {
      "comment": "Shown when the StoreKit product fails to load (network issue, App Store Connect misconfig, etc.). Apple guideline: actionable, mentions Restore as backup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access isn't available right now. Please check your connection and try again, or use Restore Purchases if you've already bought it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access no está disponible en este momento. Revisa tu conexión e inténtalo de nuevo, o usa Restaurar compras si ya lo compraste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access nie jest teraz dostępny. Sprawdź połączenie i spróbuj ponownie albo użyj opcji Przywróć zakupy, jeśli już go kupiono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access ist gerade nicht verfügbar. Bitte prüfe deine Verbindung und versuche es erneut oder nutze Käufe wiederherstellen, wenn du es bereits gekauft hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access n’est pas disponible pour le moment. Vérifiez votre connexion et réessayez, ou utilisez Restaurer les achats si vous l’avez déjà acheté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Full Access não está disponível no momento. Verifique sua conexão e tente novamente, ou use Restaurar compras se você já o comprou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access is momenteel niet beschikbaar. Controleer je verbinding en probeer het opnieuw, of gebruik Herstel aankopen als je het al hebt gekocht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Accessは現在利用できません。接続を確認してもう一度お試しください。すでに購入済みの場合は「購入を復元」を使用してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access non è disponibile al momento. Controlla la connessione e riprova, oppure usa Ripristina acquisti se lo hai già acquistato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access är inte tillgängligt just nu. Kontrollera din anslutning och försök igen, eller använd Återställ köp om du redan har köpt det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access er ikke tilgængelig lige nu. Tjek din forbindelse, og prøv igen, eller brug Gendan køb, hvis du allerede har købt det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access er ikke tilgjengelig akkurat nå. Sjekk tilkoblingen og prøv igjen, eller bruk Gjenopprett kjøp hvis du allerede har kjøpt det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access ei ole juuri nyt saatavilla. Tarkista yhteys ja yritä uudelleen tai käytä Palauta ostokset -toimintoa, jos olet jo ostanut sen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access 目前不可用。请检查你的连接并重试；如果你已经购买，请使用“恢复购买”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access сейчас недоступен. Проверьте подключение и попробуйте снова или используйте восстановление покупок, если вы уже его купили."
          }
        }
      }
    },
    "paywall.error.purchaseFailed": {
      "comment": "Shown when product.purchase() throws (network, payment method failure, etc.). Apple guideline: reassure no charge, offer retry + restore.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase couldn't be completed. No charge was made. Please try again, or use Restore Purchases if you've already bought it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar tu compra. No se realizó ningún cargo. Inténtalo de nuevo, o usa Restaurar compras si ya lo compraste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć zakupu. Nie pobrano żadnej opłaty. Spróbuj ponownie albo użyj opcji Przywróć zakupy, jeśli już go kupiono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf konnte nicht abgeschlossen werden. Es wurde nichts berechnet. Bitte versuche es erneut oder nutze Käufe wiederherstellen, wenn du es bereits gekauft hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat n’a pas pu être finalisé. Aucun débit n’a été effectué. Réessayez, ou utilisez Restaurer les achats si vous l’avez déjà acheté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra não pôde ser concluída. Nenhuma cobrança foi feita. Tente novamente ou use Restaurar compras se você já o comprou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop kon niet worden voltooid. Er is niets in rekening gebracht. Probeer het opnieuw, of gebruik Herstel aankopen als je het al hebt gekocht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。請求は発生していません。もう一度お試しください。すでに購入済みの場合は「購入を復元」を使用してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto non è stato completato. Non è stato effettuato alcun addebito. Riprova oppure usa Ripristina acquisti se lo hai già acquistato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp kunde inte slutföras. Ingen debitering gjordes. Försök igen, eller använd Återställ köp om du redan har köpt det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb kunne ikke gennemføres. Der blev ikke trukket noget beløb. Prøv igen, eller brug Gendan køb, hvis du allerede har købt det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt kunne ikke fullføres. Ingen belastning ble gjort. Prøv igjen, eller bruk Gjenopprett kjøp hvis du allerede har kjøpt det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoasi ei voitu suorittaa loppuun. Sinulta ei veloitettu mitään. Yritä uudelleen tai käytä Palauta ostokset -toimintoa, jos olet jo ostanut sen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买无法完成。没有产生扣费。请重试；如果你已经购买，请使用“恢复购买”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить покупку. Списание не произошло. Попробуйте снова или используйте восстановление покупок, если вы уже купили доступ."
          }
        }
      }
    },
    "paywall.error.verificationFailed": {
      "comment": "Shown when StoreKit transaction verification fails cryptographically. Apple guideline: actionable, never a dead-end \"contact support\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify your purchase with the App Store. Please try again. If you were charged, use Restore Purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar tu compra con el App Store. Inténtalo de nuevo. Si se realizó un cargo, usa Restaurar compras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować zakupu w App Store. Spróbuj ponownie. Jeśli pobrano opłatę, użyj opcji Przywróć zakupy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten deinen Kauf nicht mit dem App Store verifizieren. Bitte versuche es erneut. Falls dir etwas berechnet wurde, nutze Käufe wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier votre achat auprès de l’App Store. Réessayez. Si vous avez été débité, utilisez Restaurer les achats."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar sua compra com a App Store. Tente novamente. Se você foi cobrado, use Restaurar compras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je aankoop niet verifiëren bij de App Store. Probeer het opnieuw. Als er kosten in rekening zijn gebracht, gebruik dan Herstel aankopen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeで購入を確認できませんでした。もう一度お試しください。請求された場合は「購入を復元」を使用してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a verificare il tuo acquisto con l’App Store. Riprova. Se ti è stato addebitato un importo, usa Ripristina acquisti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte verifiera ditt köp med App Store. Försök igen. Om du blev debiterad, använd Återställ köp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekræfte dit køb med App Store. Prøv igen. Hvis du blev opkrævet, skal du bruge Gendan køb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekrefte kjøpet ditt med App Store. Prøv igjen. Hvis du ble belastet, bruker du Gjenopprett kjøp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme voineet vahvistaa ostostasi App Storessa. Yritä uudelleen. Jos sinua veloitettiin, käytä Palauta ostokset -toimintoa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法通过 App Store 验证你的购买。请重试。如果你已被扣费，请使用“恢复购买”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить покупку через App Store. Попробуйте снова. Если с вас списали средства, используйте восстановление покупок."
          }
        }
      }
    },
    "paywall.error.restoreFailed": {
      "comment": "Shown when AppStore.sync() throws during Restore Purchases. Apple guideline: short, actionable, no raw error codes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore failed. Please check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie nie powiodło się. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung fehlgeschlagen. Bitte prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration a échoué. Vérifiez votre connexion et réessayez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração falhou. Verifique sua conexão e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen is mislukt. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元に失敗しました。接続を確認してもう一度お試しください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino non riuscito. Controlla la connessione e riprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställningen misslyckades. Kontrollera din anslutning och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendannelse mislykkedes. Tjek din forbindelse, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretting mislyktes. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautus epäonnistui. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复失败。请检查你的连接并重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить покупки. Проверьте подключение и попробуйте снова."
          }
        }
      }
    },
    "paywall.info.nothingToRestore": {
      "comment": "Informational (not an error) — shown when Restore Purchases succeeds but no entitlement exists for this Apple ID. Apple guideline: every tap needs visible, actionable feedback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous purchases were found for this Apple ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron compras anteriores para este Apple ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono wcześniejszych zakupów dla tego Apple ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Apple ID wurden keine früheren Käufe gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat précédent n’a été trouvé pour cet identifiant Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma compra anterior foi encontrada para este Apple ID."
          }
        },
        "nl": {
