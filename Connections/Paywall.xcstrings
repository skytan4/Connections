            "value": "このApple IDには以前の購入が見つかりませんでした。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono stati trovati acquisti precedenti per questo ID Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga tidigare köp hittades för detta Apple-ID."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
