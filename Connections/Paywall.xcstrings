    "paywall.mortality.body": {
      "comment": "Body text on the Mortality Conversations feature paywall.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You tried a few selected mortality prompts. Full Access unlocks the complete library for death, grief, legacy, care, and what matters most."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probaste algunos prompts seleccionados sobre mortalidad. Full Access desbloquea toda la biblioteca sobre muerte, duelo, legado, cuidado y lo que más importa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbowano kilka wybranych promptów o śmiertelności. Full Access odblokowuje całą bibliotekę o śmierci, żałobie, dziedzictwie, opiece i tym, co najważniejsze."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ein paar ausgewählte Sterblichkeits-Impulse ausprobiert. Full Access schaltet die komplette Bibliothek über Tod, Trauer, Vermächtnis, Fürsorge und das frei, was am meisten zählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez essayé quelques questions sélectionnées sur la mortalité. Full Access débloque toute la bibliothèque sur la mort, le deuil, l’héritage, le soin et ce qui compte le plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você experimentou alguns prompts selecionados sobre mortalidade. O Full Access desbloqueia a biblioteca completa sobre morte, luto, legado, cuidado e o que mais importa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een paar geselecteerde prompts over sterfelijkheid geprobeerd. Full Access ontgrendelt de volledige bibliotheek over dood, rouw, nalatenschap, zorg en wat het meest telt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選ばれたいくつかのMortalityプロンプトを試しました。Full Accessでは、死、悲しみ、レガシー、ケア、そして本当に大切なことについてのライブラリ全体が使えます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avete provato alcuni prompt selezionati sulla mortalità. Full Access sblocca l’intera libreria su morte, lutto, eredità, cura e ciò che conta di più."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har provat några utvalda promptar om dödlighet. Full Access låser upp hela biblioteket om död, sorg, arv, omsorg och det som betyder mest."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har prøvet nogle udvalgte prompts om dødelighed. Full Access låser op for hele biblioteket om død, sorg, arv, omsorg og det, der betyder mest."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har prøvd noen utvalgte prompter om dødelighet. Full Access låser opp hele biblioteket om død, sorg, arv, omsorg og det som betyr mest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilit muutamia valittuja kuolevaisuuskehotteita. Full Access avaa koko kirjaston kuolemasta, surusta, perinnöstä, hoivasta ja siitä, mikä merkitsee eniten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你试用了几个精选的生命终点提示。Full Access 解锁完整题库，涵盖死亡、悲伤、传承、照护，以及最重要的那些事。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы попробовали несколько выбранных подсказок о смертности. Full Access открывает всю библиотеку о смерти, горе, наследии, заботе и самом важном."
          }
        }
      }
    },
