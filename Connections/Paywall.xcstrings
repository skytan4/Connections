    "paywall.general.bullet5": {
      "comment": "Benefit-focused feature bullet on the general paywall screen. Arg 1: premium prompt/follow-up count. Arg 2: total prompt/follow-up count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock %1$@ premium prompts and follow-ups, for %2$@ total"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea %1$@ prompts y seguimientos premium, para un total de %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj %1$@ premium promptów i pytań pogłębiających, łącznie %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte %1$@ Premium-Prompts und Folgefragen frei, insgesamt %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque %1$@ questions et relances premium, pour %2$@ au total"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie %1$@ prompts e perguntas de acompanhamento premium, totalizando %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel %1$@ premium prompts en vervolgvragen, voor %2$@ in totaal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@件のプレミアム質問とフォローアップ質問をアンロックし、合計%2$@件に"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca %1$@ prompt e domande di approfondimento premium, per un totale di %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp %1$@ premium-promptar och uppföljningsfrågor, totalt %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås op for %1$@ premium-prompts og opfølgende spørgsmål, %2$@ i alt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp %1$@ premium-prompter og oppfølgingsspørsmål, totalt %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa %1$@ premium-kysymystä ja jatkokysymystä, yhteensä %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 %1$@ 个高级问题和跟进问题，共计 %2$@ 个"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте %1$@ премиум-вопросов и уточнений, всего %2$@"
          }
        }
      }
    },
    "paywall.general.footer": {
      "comment": "Footer text below the feature list on the general paywall screen. Markdown bold markers around numbers are intentional.",
      "extractionState": "manual",
      "localizations": {
